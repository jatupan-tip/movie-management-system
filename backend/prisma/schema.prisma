generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rating {
  G
  PG
  M
  MA
  R
}

model Movie {
  id            Int      @id @default(autoincrement())

  title         String
  yearReleased  Int
  rating        Rating

  imageUrl      String?

  createdAt     DateTime @default(now())
  createdBy     String?

  updatedAt     DateTime? @updatedAt
  updatedBy     String?
}

enum Role {
  MANAGER
  TEAMLEADER
  FLOORSTAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id         Int      @id @default(autoincrement())

  username   String?   @unique
  email      String   @unique
  password   String

  status     UserStatus @default(ACTIVE)

  role       Role

  createdAt  DateTime @default(now())
}